{
	"name": "@filen/shared",
	"version": "0.0.12",
	"description": "Code shared by the Filen apps",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/FilenCloudDienste/filen-ts/packages/filen-shared"
	},
	"author": "Filen Cloud Dienste UG",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"dev": "tsx src/dev.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"lint": "eslint src/"
	},
	"engines": {
		"node": ">=24"
	},
	"license": "AGPLv3",
	"devDependencies": {
		"@eslint/js": "^9.39.3",
		"@types/node": "^24.0.0",
		"eslint": "^9.39.3",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"node-html-better-parser": "^1.5.8",
		"striptags": "^3.2.0",
		"tailwind-merge": "^3.3.1",
		"uuid": "^13.0.0"
	}
}
