<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Filen SmartArt gallery definition. Written by Filen from the semantics of ECMA-376 Part 1 §21.4 (DrawingML
	diagrams); no Microsoft definition file was copied or used as a source.
	nameKey: previewPptxSmartArtLayoutVerticalBulletList
-->
<sa:layoutDef xmlns:sa="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:dr="http://schemas.openxmlformats.org/drawingml/2006/main" uniqueId="urn:filen:smartart:layout:list-vertical-bullet">
	<sa:title val="Vertical bullet list"/>
	<sa:desc val="Each top-level item is a full-width heading band, top to bottom; its sub-items are a bulleted panel right under it."/>
	<sa:catLst>
		<sa:cat type="list" pri="20"/>
	</sa:catLst>
	<sa:sampData>
		<sa:dataModel>
			<sa:ptLst>
				<sa:pt modelId="100" type="doc"/>
				<sa:pt modelId="101"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="102"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="103"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="104"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="105"><sa:prSet phldr="1"/></sa:pt>
			</sa:ptLst>
			<sa:cxnLst>
				<sa:cxn modelId="200" srcId="100" destId="101" srcOrd="0" destOrd="0"/>
				<sa:cxn modelId="201" srcId="101" destId="102" srcOrd="0" destOrd="0"/>
				<sa:cxn modelId="202" srcId="101" destId="103" srcOrd="1" destOrd="0"/>
				<sa:cxn modelId="203" srcId="100" destId="104" srcOrd="1" destOrd="0"/>
				<sa:cxn modelId="204" srcId="104" destId="105" srcOrd="0" destOrd="0"/>
			</sa:cxnLst>
			<sa:bg/>
			<sa:whole/>
		</sa:dataModel>
	</sa:sampData>
	<sa:layoutNode name="stack">
		<sa:varLst>
			<sa:dir/>
			<sa:animLvl val="lvl"/>
			<sa:resizeHandles val="exact"/>
		</sa:varLst>
		<sa:alg type="lin">
			<sa:param type="linDir" val="fromT"/>
			<sa:param type="vertAlign" val="mid"/>
			<sa:param type="nodeHorzAlign" val="ctr"/>
		</sa:alg>
		<sa:shape><sa:adjLst/></sa:shape>
		<sa:presOf/>
		<sa:constrLst>
			<sa:constr for="ch" forName="band" type="w" refType="w"/>
			<sa:constr for="ch" forName="band" type="h" refType="h" fact="0.18"/>
			<sa:constr for="ch" forName="panel" type="w" refType="w"/>
			<sa:constr for="ch" forName="panel" type="h" refType="h" fact="0.2"/>
			<sa:constr for="ch" forName="space" type="h" refType="h" fact="0.035"/>
			<sa:constr for="ch" forName="band" type="primFontSz" op="equ" val="40"/>
			<sa:constr for="ch" forName="panel" type="primFontSz" op="equ" val="30"/>
		</sa:constrLst>
		<sa:ruleLst/>
		<sa:forEach name="items" ptType="node" axis="ch">
			<sa:layoutNode name="band" styleLbl="node1">
				<sa:varLst>
					<sa:bulletEnabled val="1"/>
				</sa:varLst>
				<sa:alg type="tx">
					<sa:param type="parTxLTRAlign" val="l"/>
				</sa:alg>
				<sa:shape type="roundRect">
					<sa:adjLst>
						<sa:adj idx="1" val="0.2"/>
					</sa:adjLst>
				</sa:shape>
				<sa:presOf axis="self"/>
				<sa:constrLst>
					<sa:constr type="lMarg" refType="primFontSz" fact="0.6"/>
					<sa:constr type="rMarg" refType="primFontSz" fact="0.6"/>
					<sa:constr type="tMarg" refType="primFontSz" fact="0.2"/>
					<sa:constr type="bMarg" refType="primFontSz" fact="0.2"/>
				</sa:constrLst>
				<sa:ruleLst>
					<sa:rule type="primFontSz" val="5" fact="NaN" max="NaN"/>
				</sa:ruleLst>
			</sa:layoutNode>
			<sa:choose name="details">
				<sa:if name="hasDetails" func="cnt" axis="ch" ptType="node" op="gte" val="1">
					<sa:layoutNode name="panel" styleLbl="alignAcc1">
						<sa:varLst>
							<sa:bulletEnabled val="1"/>
						</sa:varLst>
						<sa:alg type="tx">
							<sa:param type="txAnchorVert" val="t"/>
							<sa:param type="parTxLTRAlign" val="l"/>
						</sa:alg>
						<sa:shape type="rect"><sa:adjLst/></sa:shape>
						<sa:presOf axis="des" ptType="node"/>
						<sa:constrLst>
							<sa:constr type="lMarg" refType="primFontSz" fact="1.4"/>
							<sa:constr type="rMarg" refType="primFontSz" fact="0.4"/>
							<sa:constr type="tMarg" refType="primFontSz" fact="0.25"/>
							<sa:constr type="bMarg" refType="primFontSz" fact="0.25"/>
						</sa:constrLst>
						<sa:ruleLst>
							<sa:rule type="primFontSz" val="5" fact="NaN" max="NaN"/>
						</sa:ruleLst>
					</sa:layoutNode>
				</sa:if>
				<sa:else name="noDetails"/>
			</sa:choose>
			<sa:forEach name="spaces" ptType="sibTrans" axis="followSib" cnt="1">
				<sa:layoutNode name="space">
					<sa:alg type="sp"/>
					<sa:shape><sa:adjLst/></sa:shape>
					<sa:presOf/>
					<sa:constrLst/>
					<sa:ruleLst/>
				</sa:layoutNode>
			</sa:forEach>
		</sa:forEach>
	</sa:layoutNode>
</sa:layoutDef>
