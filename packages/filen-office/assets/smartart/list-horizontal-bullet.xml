<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Filen SmartArt gallery definition. Written by Filen from the semantics of ECMA-376 Part 1 §21.4 (DrawingML
	diagrams); no Microsoft definition file was copied or used as a source.
	nameKey: previewPptxSmartArtLayoutHorizontalBulletList
-->
<sa:layoutDef xmlns:sa="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:dr="http://schemas.openxmlformats.org/drawingml/2006/main" uniqueId="urn:filen:smartart:layout:list-horizontal-bullet">
	<sa:title val="Horizontal bullet list"/>
	<sa:desc val="Each top-level item is a column, left to right: a heading on top and its sub-items as bullets in the panel below."/>
	<sa:catLst>
		<sa:cat type="list" pri="30"/>
	</sa:catLst>
	<sa:sampData>
		<sa:dataModel>
			<sa:ptLst>
				<sa:pt modelId="100" type="doc"/>
				<sa:pt modelId="101"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="102"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="103"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="104"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="105"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="106"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="107"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="108"><sa:prSet phldr="1"/></sa:pt>
				<sa:pt modelId="109"><sa:prSet phldr="1"/></sa:pt>
			</sa:ptLst>
			<sa:cxnLst>
				<sa:cxn modelId="200" srcId="100" destId="101" srcOrd="0" destOrd="0"/>
				<sa:cxn modelId="201" srcId="101" destId="102" srcOrd="0" destOrd="0"/>
				<sa:cxn modelId="202" srcId="101" destId="103" srcOrd="1" destOrd="0"/>
				<sa:cxn modelId="203" srcId="100" destId="104" srcOrd="1" destOrd="0"/>
				<sa:cxn modelId="204" srcId="104" destId="105" srcOrd="0" destOrd="0"/>
				<sa:cxn modelId="205" srcId="104" destId="106" srcOrd="1" destOrd="0"/>
				<sa:cxn modelId="206" srcId="100" destId="107" srcOrd="2" destOrd="0"/>
				<sa:cxn modelId="207" srcId="107" destId="108" srcOrd="0" destOrd="0"/>
				<sa:cxn modelId="208" srcId="107" destId="109" srcOrd="1" destOrd="0"/>
			</sa:cxnLst>
			<sa:bg/>
			<sa:whole/>
		</sa:dataModel>
	</sa:sampData>
	<sa:layoutNode name="columns">
		<sa:varLst>
			<sa:dir/>
			<sa:animLvl val="lvl"/>
			<sa:resizeHandles val="exact"/>
		</sa:varLst>
		<sa:choose name="reading">
			<sa:if name="fromLeft" func="var" arg="dir" op="equ" val="norm">
				<sa:alg type="lin">
					<sa:param type="linDir" val="fromL"/>
					<sa:param type="nodeVertAlign" val="t"/>
				</sa:alg>
			</sa:if>
			<sa:else name="fromRight">
				<sa:alg type="lin">
					<sa:param type="linDir" val="fromR"/>
					<sa:param type="nodeVertAlign" val="t"/>
				</sa:alg>
			</sa:else>
		</sa:choose>
		<sa:shape><sa:adjLst/></sa:shape>
		<sa:presOf/>
		<sa:constrLst>
			<sa:constr for="ch" forName="column" type="w" refType="w"/>
			<sa:constr for="ch" forName="column" type="h" refType="h"/>
			<sa:constr for="ch" forName="space" type="w" refFor="ch" refForName="column" refType="w" fact="0.06"/>
			<sa:constr for="des" forName="heading" type="primFontSz" op="equ" val="40"/>
			<sa:constr for="des" forName="panel" type="primFontSz" op="equ" val="30"/>
			<sa:constr for="des" forName="heading" type="h" refFor="des" refForName="heading" refType="primFontSz" fact="0.9"/>
		</sa:constrLst>
		<sa:ruleLst/>
		<sa:forEach name="items" ptType="node" axis="ch">
			<sa:layoutNode name="column">
				<sa:alg type="composite"/>
				<sa:shape><sa:adjLst/></sa:shape>
				<sa:presOf/>
				<sa:constrLst>
					<sa:constr for="ch" forName="heading" type="l"/>
					<sa:constr for="ch" forName="heading" type="t"/>
					<sa:constr for="ch" forName="heading" type="w" refType="w"/>
					<sa:constr for="ch" forName="panel" type="l"/>
					<sa:constr for="ch" forName="panel" type="w" refType="w"/>
					<sa:constr for="ch" forName="panel" type="t" refFor="ch" refForName="heading" refType="h"/>
					<sa:constr for="ch" forName="panel" type="b" refType="h"/>
				</sa:constrLst>
				<sa:ruleLst/>
				<sa:layoutNode name="heading" styleLbl="node1">
					<sa:alg type="tx"/>
					<sa:shape type="rect"><sa:adjLst/></sa:shape>
					<sa:presOf axis="self"/>
					<sa:constrLst>
						<sa:constr type="lMarg" refType="primFontSz" fact="0.35"/>
						<sa:constr type="rMarg" refType="primFontSz" fact="0.35"/>
						<sa:constr type="tMarg" refType="primFontSz" fact="0.2"/>
						<sa:constr type="bMarg" refType="primFontSz" fact="0.2"/>
					</sa:constrLst>
					<sa:ruleLst>
						<sa:rule type="primFontSz" val="5" fact="NaN" max="NaN"/>
					</sa:ruleLst>
				</sa:layoutNode>
				<sa:layoutNode name="panel" styleLbl="alignAcc1">
					<sa:varLst>
						<sa:bulletEnabled val="1"/>
					</sa:varLst>
					<sa:alg type="tx">
						<sa:param type="txAnchorVert" val="t"/>
						<sa:param type="parTxLTRAlign" val="l"/>
					</sa:alg>
					<sa:shape type="rect"><sa:adjLst/></sa:shape>
					<sa:presOf axis="des" ptType="node"/>
					<sa:constrLst>
						<sa:constr type="lMarg" refType="primFontSz" fact="0.35"/>
						<sa:constr type="rMarg" refType="primFontSz" fact="0.35"/>
						<sa:constr type="tMarg" refType="primFontSz" fact="0.35"/>
						<sa:constr type="bMarg" refType="primFontSz" fact="0.35"/>
					</sa:constrLst>
					<sa:ruleLst>
						<sa:rule type="primFontSz" val="5" fact="NaN" max="NaN"/>
					</sa:ruleLst>
				</sa:layoutNode>
			</sa:layoutNode>
			<sa:forEach name="spaces" ptType="sibTrans" axis="followSib" cnt="1">
				<sa:layoutNode name="space">
					<sa:alg type="sp"/>
					<sa:shape><sa:adjLst/></sa:shape>
					<sa:presOf/>
					<sa:constrLst/>
					<sa:ruleLst/>
				</sa:layoutNode>
			</sa:forEach>
		</sa:forEach>
	</sa:layoutNode>
</sa:layoutDef>
