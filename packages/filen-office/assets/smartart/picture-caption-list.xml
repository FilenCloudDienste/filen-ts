<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Filen SmartArt gallery definition. Written by Filen from the semantics of ECMA-376 Part 1 §21.4 (DrawingML
	diagrams); no Microsoft definition file was copied or used as a source.
	nameKey: previewPptxSmartArtLayoutPictureCaptionList
-->
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" uniqueId="urn:filen:smartart:layout:picture-caption-list">
	<dgm:title val="Picture caption list"/>
	<dgm:desc val="A picture for every top-level item with its text in a bar right under it; sub-items are listed in the bar. The pictures flow in rows."/>
	<dgm:catLst>
		<dgm:cat type="picture" pri="100"/>
	</dgm:catLst>
	<dgm:sampData>
		<dgm:dataModel>
			<dgm:ptLst>
				<dgm:pt modelId="0" type="doc"/>
				<dgm:pt modelId="1"><dgm:prSet phldr="1"/></dgm:pt>
				<dgm:pt modelId="2"><dgm:prSet phldr="1"/></dgm:pt>
				<dgm:pt modelId="3"><dgm:prSet phldr="1"/></dgm:pt>
			</dgm:ptLst>
			<dgm:cxnLst>
				<dgm:cxn modelId="100" srcId="0" destId="1" srcOrd="0" destOrd="0"/>
				<dgm:cxn modelId="101" srcId="0" destId="2" srcOrd="1" destOrd="0"/>
				<dgm:cxn modelId="102" srcId="0" destId="3" srcOrd="2" destOrd="0"/>
			</dgm:cxnLst>
			<dgm:bg/>
			<dgm:whole/>
		</dgm:dataModel>
	</dgm:sampData>
	<dgm:layoutNode name="gallery">
		<dgm:varLst>
			<dgm:dir/>
			<dgm:resizeHandles val="exact"/>
		</dgm:varLst>
		<dgm:choose name="flowOrder">
			<dgm:if name="flowFromLeft" func="var" arg="dir" op="equ" val="norm">
				<dgm:alg type="snake">
					<dgm:param type="grDir" val="tL"/>
					<dgm:param type="flowDir" val="row"/>
					<dgm:param type="contDir" val="sameDir"/>
					<dgm:param type="off" val="ctr"/>
				</dgm:alg>
			</dgm:if>
			<dgm:else name="flowFromRight">
				<dgm:alg type="snake">
					<dgm:param type="grDir" val="tR"/>
					<dgm:param type="flowDir" val="row"/>
					<dgm:param type="contDir" val="sameDir"/>
					<dgm:param type="off" val="ctr"/>
				</dgm:alg>
			</dgm:else>
		</dgm:choose>
		<dgm:shape><dgm:adjLst/></dgm:shape>
		<dgm:presOf/>
		<dgm:constrLst>
			<dgm:constr type="w" for="ch" forName="entry" refType="w" fact="0.3"/>
			<dgm:constr type="h" for="ch" forName="entry" refType="w" refFor="ch" refForName="entry" fact="1.05"/>
			<dgm:constr type="w" for="ch" forName="entryGap" refType="w" refFor="ch" refForName="entry" fact="0.08"/>
			<dgm:constr type="sp" refType="w" refFor="ch" refForName="entry" fact="0.08"/>
			<dgm:constr type="primFontSz" for="des" forName="caption" op="equ" val="40"/>
		</dgm:constrLst>
		<dgm:ruleLst/>
		<dgm:forEach name="entries" axis="ch" ptType="node">
			<dgm:layoutNode name="entry">
				<dgm:alg type="composite"/>
				<dgm:shape><dgm:adjLst/></dgm:shape>
				<dgm:presOf/>
				<dgm:constrLst>
					<dgm:constr type="l" for="ch" forName="photo"/>
					<dgm:constr type="t" for="ch" forName="photo"/>
					<dgm:constr type="w" for="ch" forName="photo" refType="w"/>
					<dgm:constr type="h" for="ch" forName="photo" refType="h" fact="0.72"/>
					<dgm:constr type="l" for="ch" forName="caption"/>
					<dgm:constr type="t" for="ch" forName="caption" refType="h" fact="0.72"/>
					<dgm:constr type="w" for="ch" forName="caption" refType="w"/>
					<dgm:constr type="h" for="ch" forName="caption" refType="h" fact="0.28"/>
				</dgm:constrLst>
				<dgm:ruleLst/>
					<dgm:layoutNode name="photo" styleLbl="alignImgPlace1">
						<dgm:alg type="sp"/>
						<dgm:shape type="rect" r:blip="" blipPhldr="1"><dgm:adjLst/></dgm:shape>
						<dgm:presOf/>
						<dgm:constrLst/>
						<dgm:ruleLst/>
					</dgm:layoutNode>
				<dgm:layoutNode name="caption" styleLbl="node1">
					<dgm:varLst>
						<dgm:bulletEnabled val="1"/>
					</dgm:varLst>
					<dgm:alg type="tx">
						<dgm:param type="txAnchorVert" val="t"/>
					</dgm:alg>
					<dgm:shape type="rect"><dgm:adjLst/></dgm:shape>
					<dgm:presOf axis="desOrSelf" ptType="node"/>
					<dgm:constrLst>
						<dgm:constr type="lMarg" refType="primFontSz" fact="0.2"/>
						<dgm:constr type="rMarg" refType="primFontSz" fact="0.2"/>
						<dgm:constr type="tMarg" refType="primFontSz" fact="0.12"/>
						<dgm:constr type="bMarg" refType="primFontSz" fact="0.12"/>
					</dgm:constrLst>
					<dgm:ruleLst>
						<dgm:rule type="primFontSz" val="5" fact="NaN" max="NaN"/>
					</dgm:ruleLst>
				</dgm:layoutNode>
			</dgm:layoutNode>
				<dgm:forEach name="entryGaps" axis="followSib" ptType="sibTrans" cnt="1">
					<dgm:layoutNode name="entryGap">
						<dgm:alg type="sp"/>
						<dgm:shape><dgm:adjLst/></dgm:shape>
						<dgm:presOf/>
						<dgm:constrLst/>
						<dgm:ruleLst/>
					</dgm:layoutNode>
				</dgm:forEach>
		</dgm:forEach>
	</dgm:layoutNode>
</dgm:layoutDef>
