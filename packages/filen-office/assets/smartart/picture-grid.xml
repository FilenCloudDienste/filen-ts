<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Filen SmartArt gallery definition. Written by Filen from the semantics of ECMA-376 Part 1 §21.4 (DrawingML
	diagrams); no Microsoft definition file was copied or used as a source.
	nameKey: previewPptxSmartArtLayoutPictureGrid
-->
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" uniqueId="urn:filen:smartart:layout:picture-grid">
	<dgm:title val="Picture grid"/>
	<dgm:desc val="Square pictures in a grid with as many rows as columns, each under a heading that is its top-level item; sub-items are listed in the heading."/>
	<dgm:catLst>
		<dgm:cat type="picture" pri="300"/>
	</dgm:catLst>
	<dgm:sampData>
		<dgm:dataModel>
			<dgm:ptLst>
				<dgm:pt modelId="0" type="doc"/>
				<dgm:pt modelId="1"><dgm:prSet phldr="1"/></dgm:pt>
				<dgm:pt modelId="2"><dgm:prSet phldr="1"/></dgm:pt>
				<dgm:pt modelId="3"><dgm:prSet phldr="1"/></dgm:pt>
				<dgm:pt modelId="4"><dgm:prSet phldr="1"/></dgm:pt>
			</dgm:ptLst>
			<dgm:cxnLst>
				<dgm:cxn modelId="120" srcId="0" destId="1" srcOrd="0" destOrd="0"/>
				<dgm:cxn modelId="121" srcId="0" destId="2" srcOrd="1" destOrd="0"/>
				<dgm:cxn modelId="122" srcId="0" destId="3" srcOrd="2" destOrd="0"/>
				<dgm:cxn modelId="123" srcId="0" destId="4" srcOrd="3" destOrd="0"/>
			</dgm:cxnLst>
			<dgm:bg/>
			<dgm:whole/>
		</dgm:dataModel>
	</dgm:sampData>
	<dgm:layoutNode name="grid">
		<dgm:varLst>
			<dgm:dir/>
			<dgm:resizeHandles val="exact"/>
		</dgm:varLst>
		<dgm:choose name="gridOrder">
			<dgm:if name="gridFromLeft" func="var" arg="dir" op="equ" val="norm">
				<dgm:alg type="snake">
					<dgm:param type="grDir" val="tL"/>
					<dgm:param type="flowDir" val="row"/>
					<dgm:param type="contDir" val="sameDir"/>
					<dgm:param type="bkpt" val="bal"/>
					<dgm:param type="off" val="ctr"/>
				</dgm:alg>
			</dgm:if>
			<dgm:else name="gridFromRight">
				<dgm:alg type="snake">
					<dgm:param type="grDir" val="tR"/>
					<dgm:param type="flowDir" val="row"/>
					<dgm:param type="contDir" val="sameDir"/>
					<dgm:param type="bkpt" val="bal"/>
					<dgm:param type="off" val="ctr"/>
				</dgm:alg>
			</dgm:else>
		</dgm:choose>
		<dgm:shape><dgm:adjLst/></dgm:shape>
		<dgm:presOf/>
		<dgm:constrLst>
			<dgm:constr type="w" for="ch" forName="frame" refType="w" fact="0.3"/>
			<dgm:constr type="h" for="ch" forName="frame" refType="w" refFor="ch" refForName="frame" fact="1.35"/>
			<dgm:constr type="w" for="ch" forName="frameGap" refType="w" refFor="ch" refForName="frame" fact="0.05"/>
			<dgm:constr type="sp" refType="w" refFor="ch" refForName="frame" fact="0.05"/>
			<dgm:constr type="primFontSz" for="des" forName="heading" op="equ" val="40"/>
		</dgm:constrLst>
		<dgm:ruleLst/>
		<dgm:forEach name="frames" axis="ch" ptType="node">
			<dgm:layoutNode name="frame">
				<dgm:alg type="composite"/>
				<dgm:shape><dgm:adjLst/></dgm:shape>
				<dgm:presOf/>
				<dgm:constrLst>
					<dgm:constr type="l" for="ch" forName="heading"/>
					<dgm:constr type="t" for="ch" forName="heading"/>
					<dgm:constr type="w" for="ch" forName="heading" refType="w"/>
					<dgm:constr type="h" for="ch" forName="heading" refType="h" fact="0.26"/>
					<dgm:constr type="l" for="ch" forName="picture"/>
					<dgm:constr type="t" for="ch" forName="picture" refType="h" fact="0.26"/>
					<dgm:constr type="w" for="ch" forName="picture" refType="w"/>
					<dgm:constr type="h" for="ch" forName="picture" refType="h" fact="0.74"/>
				</dgm:constrLst>
				<dgm:ruleLst/>
				<dgm:layoutNode name="heading" styleLbl="revTx">
					<dgm:varLst>
						<dgm:bulletEnabled val="1"/>
					</dgm:varLst>
					<dgm:alg type="tx">
						<dgm:param type="parTxLTRAlign" val="l"/>
						<dgm:param type="shpTxLTRAlignCh" val="l"/>
						<dgm:param type="txAnchorVert" val="b"/>
					</dgm:alg>
					<dgm:shape type="rect" hideGeom="1"><dgm:adjLst/></dgm:shape>
					<dgm:presOf axis="desOrSelf" ptType="node"/>
					<dgm:constrLst>
						<dgm:constr type="lMarg"/>
						<dgm:constr type="rMarg"/>
						<dgm:constr type="tMarg" refType="primFontSz" fact="0.1"/>
						<dgm:constr type="bMarg" refType="primFontSz" fact="0.15"/>
					</dgm:constrLst>
					<dgm:ruleLst>
						<dgm:rule type="primFontSz" val="5" fact="NaN" max="NaN"/>
					</dgm:ruleLst>
				</dgm:layoutNode>
				<dgm:layoutNode name="picture" styleLbl="alignImgPlace1">
					<dgm:alg type="sp"/>
					<dgm:shape type="rect" r:blip="" blipPhldr="1"><dgm:adjLst/></dgm:shape>
					<dgm:presOf/>
					<dgm:constrLst/>
					<dgm:ruleLst/>
				</dgm:layoutNode>
			</dgm:layoutNode>
			<dgm:forEach name="frameGaps" axis="followSib" ptType="sibTrans" cnt="1">
				<dgm:layoutNode name="frameGap">
					<dgm:alg type="sp"/>
					<dgm:shape><dgm:adjLst/></dgm:shape>
					<dgm:presOf/>
					<dgm:constrLst/>
					<dgm:ruleLst/>
				</dgm:layoutNode>
			</dgm:forEach>
		</dgm:forEach>
	</dgm:layoutNode>
</dgm:layoutDef>
