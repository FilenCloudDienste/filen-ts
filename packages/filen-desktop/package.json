{
	"name": "@filen/desktop",
	"version": "4.0.0-alpha.0",
	"description": "Filen Desktop Client",
	"homepage": "https://filen.io",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FilenCloudDienste/filen-ts.git"
	},
	"license": "AGPLv3",
	"author": "Filen Cloud Dienste UG (haftungsbeschränkt) <support@filen.io>",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"desktopName": "Filen.desktop",
	"scripts": {
		"build": "node scripts/build.ts",
		"dev": "node scripts/stageNapi.ts --dev && node scripts/buildFpAddon.ts --dev && node scripts/build.ts && node scripts/dev.ts",
		"dev:dist": "node scripts/stageNapi.ts --dev && node scripts/buildFpAddon.ts --dev && node scripts/build.ts && electron .",
		"dist": "node scripts/dist.ts",
		"lint": "eslint . && prettier --check \"**/*.ts\"",
		"format": "prettier --write \"**/*.ts\"",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"verify": "pnpm run lint && pnpm run typecheck && pnpm run test"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@filen/sdk-rs": "0.5.11",
		"@filen/shared": "workspace:*",
		"@peculiar/x509": "^2.2.0",
		"@types/node": "^24.19.2",
		"arktype": "^2.2.9",
		"electron": "45.0.0",
		"electron-builder": "26.18.0",
		"electron-updater": "6.8.11",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"fflate": "^0.8.3",
		"node-api-headers": "1.9.0",
		"prettier": "^3.9.10",
		"reflect-metadata": "^0.2.2",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}
