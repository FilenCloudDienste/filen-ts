{
	"name": "@filen/utils",
	"version": "0.0.12",
	"description": "A collection of utils for Filen",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/FilenCloudDienste/filen-ts/packages/filen-utils"
	},
	"author": "Filen Cloud Dienste UG",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"main": "dist/index.js",
		"types": "dist/types/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "pnpm run build:clean && tsc --extendedDiagnostics --project tsconfig.build.json",
		"build:clean": "rimraf ./dist",
		"typecheck": "tsc --noEmit",
		"dev": "tsx src/dev.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"lint": "eslint src/"
	},
	"keywords": [
		"filen"
	],
	"engines": {
		"node": ">=24"
	},
	"license": "AGPLv3",
	"devDependencies": {
		"@eslint/js": "^9.39.3",
		"@types/node": "^24.0.0",
		"eslint": "^9.39.3",
		"rimraf": "^6.1.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"node-html-better-parser": "^1.5.8",
		"striptags": "^3.2.0",
		"tailwind-merge": "^3.3.1",
		"uuid": "^13.0.0"
	}
}
