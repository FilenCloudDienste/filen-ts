// Production is the top-level Worker; `--env staging` deploys the same build as a separate Worker.
// Both serve dist/ as static assets; the response headers come from dist/_headers, generated by the
// build from vite.config.ts (see README § Deployment).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "filen-web",
	"main": "cloudflare/worker.ts",
	"compatibility_date": "2026-09-30",
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"workers_dev": true,
	"preview_urls": false,
	"env": {
		"staging": {
			"name": "filen-web-staging"
		}
	}
}
