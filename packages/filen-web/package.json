	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && vite build -c vite.sw.config.ts",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"lint": "eslint . && prettier --check \"**/*.{ts,tsx}\"",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"test": "vitest run",
		"test:e2e": "playwright test",
