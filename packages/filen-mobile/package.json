{
	"name": "@filen/mobile",
	"main": "./src/entry",
	"version": "0.0.0",
	"private": false,
	"scripts": {
		"postinstall": "sh scripts/postinstall.sh",
		"start": "expo start --clear",
		"android": "expo run:android",
		"android:device": "expo run:android --device",
		"android:release": "expo run:android --variant release",
		"android:device:release": "expo run:android --variant release --device",
		"ios": "expo run:ios",
		"ios:release": "expo run:ios --configuration Release",
		"ios:device": "expo run:ios --device",
		"ios:device:release": "expo run:ios --device --configuration Release",
		"lint": "eslint --report-unused-disable-directives --max-warnings 0 --no-warn-ignored",
		"prebuild": "expo prebuild",
		"prebuild:clean": "npm run clean && expo prebuild --clean",
		"prebuild:ci:android": "npm run superclean && expo prebuild --clean --platform android",
		"prebuild:ci:ios": "npm run superclean && expo prebuild --clean --platform ios",
		"typecheck": "node typecheck.mjs",
		"ncu": "npx expo install --fix && ncu --interactive --format group && npx expo install --fix",
		"expo:install:fix": "npx expo install --fix",
		"clean": "tsx ./clean.ts",
		"superclean": "tsx ./superclean.ts",
		"test": "vitest run",
		"translate-i18n": "tsx scripts/translate-i18n.ts",
		"notices": "tsx scripts/generateThirdPartyNotices.ts",
		"verify": "npm run lint && npm run typecheck && npm run test"
	},
	"expo": {
		"install": {
			"//": "react-native-worklets is held ABOVE the Expo SDK pin (0.10.1) and BELOW its own latest. The floor: 0.10.2 stops createSerializable from throwing and fixes the ScriptBufferWrapper absolute-path read (software-mansion/react-native-reanimated#9884, #9503), on top of the 0.10.1 scheduleOnRN/runOnJS use-after-free that segfaults release builds (#9751, fix PR #9789). The ceiling is 0.10.x: expo-modules-core declares peerOptional react-native-worklets \"^0.7.4 || ^0.8.0 || ^0.9.0 || ^0.10.0\", and reanimated 4.5.1 peers 0.10.x, so 0.11/0.12 do not resolve on this SDK — reanimated 4.6.0 needs worklets 0.12.x and is therefore NOT installable here either. Revisit both together only when the Expo pin moves.",
			"exclude": [
				"@shopify/flash-list",
				"react-native-worklets"
			]
		},
		"autolinking": {
			"buildFromSource": [
				".*"
			]
		}
	},
	"op-sqlite": {
		"sqlcipher": false,
		"performanceMode": true,
		"iosSqlite": false,
		"sqliteFlags": "-DSQLITE_DQS=0 -DSQLITE_TEMP_STORE=2",
		"fts5": false,
		"rtree": false,
		"libsql": false,
		"sqliteVec": false,
		"tokenizers": []
	},
	"dependencies": {
		"@blazejkustra/react-native-alert": "^1.1.0",
