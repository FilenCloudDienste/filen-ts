{
	"name": "@filen/mobile",
	"main": "./src/entry",
	"version": "0.0.0",
	"private": false,
	"scripts": {
		"start": "expo start --clear",
		"android": "expo run:android",
		"android:device": "expo run:android --device",
		"android:release": "expo run:android --variant release",
		"android:device:release": "expo run:android --variant release --device",
		"ios": "expo run:ios",
		"ios:release": "expo run:ios --configuration Release",
		"ios:device": "expo run:ios --device",
		"ios:device:release": "expo run:ios --device --configuration Release",
		"lint": "eslint --report-unused-disable-directives --max-warnings 0 --no-warn-ignored",
		"prebuild": "expo prebuild",
		"prebuild:clean": "pnpm run clean && expo prebuild --clean",
		"prebuild:ci:android": "pnpm run superclean && expo prebuild --clean --platform android",
		"prebuild:ci:ios": "pnpm run superclean && expo prebuild --clean --platform ios",
		"typecheck": "node typecheck.mjs",
		"ncu": "expo install --fix && ncu --interactive --format group && expo install --fix",
		"expo:install:fix": "expo install --fix",
		"clean": "tsx ./clean.ts",
		"superclean": "tsx ./clean.ts --deep",
		"test": "vitest run",
		"translate-i18n": "tsx scripts/translate-i18n.ts",
		"notices": "tsx scripts/generateThirdPartyNotices.ts",
		"verify": "pnpm run lint && pnpm run typecheck && pnpm run test"
	},
	"expo": {
		"install": {
			"//": "@shopify/flash-list is held at 2.3.3 above the Expo SDK pin (2.3.2) for Shopify/flash-list#2510: with drawDistance={0} (components/ui/virtualList.tsx) the render window could fall behind the viewport during flings and leave blank rows. Remove once the Expo pin reaches 2.3.3. react-native-gesture-handler is held at 3.4.x above the Expo SDK pin (~3.3.0): on iOS, 3.3 overwrites a manually activated handler's state back to BEGAN, so every manualActivation gesture (gallery pinch, zoomed pan, swipe-down dismiss) never receives updates (fixed in RNGestureHandler.mm in 3.4.0). Remove once the Expo pin reaches 3.4.",
			"exclude": [
				"@shopify/flash-list",
				"react-native-gesture-handler"
			]
		},
		"autolinking": {
			"buildFromSource": [
				".*"
			]
		}
	},
	"op-sqlite": {
		"sqlcipher": false,
		"performanceMode": true,
		"iosSqlite": false,
		"sqliteFlags": "-DSQLITE_DQS=0 -DSQLITE_TEMP_STORE=2",
		"fts5": false,
		"rtree": false,
		"libsql": false,
		"sqliteVec": false,
		"tokenizers": []
	},
