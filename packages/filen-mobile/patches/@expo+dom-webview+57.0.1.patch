+      decisionHandler(.allow)
+      return
+    }
+
+    guard navigationAction.targetFrame?.isMainFrame ?? true else {
+      decisionHandler(.allow)
+      return
+    }
+
+    if url.scheme?.lowercased() == "about" {
+      decisionHandler(.allow)
+      return
+    }
+
+    guard let currentUrl = webView.url else {
