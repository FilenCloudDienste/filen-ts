 // Parse an FBX file in Binary format
+// Patched: a compressed array inflates into exactly the bytes its declared length takes, fed to the inflater a step at
+// a time and stopped as soon as it would outgrow them, so a zlib bomb costs neither memory nor time past its declared
+// size (unzlibSync grows its output without limit).
+const ARRAY_ELEMENT_BYTES = { b: 1, c: 1, d: 8, f: 4, i: 4, l: 8 };
+const INFLATE_STEP = 4096;
+
+function inflateArray( compressed, size ) {
+
+	const out = new Uint8Array( size );
+	let at = 0;
+	const inflater = new Unzlib( function ( chunk ) {
+
+		if ( at + chunk.length > size ) throw new Error( 'THREE.FBXLoader: a compressed array inflates past its declared length' );
+
+		out.set( chunk, at );
+		at += chunk.length;
+
+	} );
+
+	for ( let i = 0; i < compressed.length; i += INFLATE_STEP ) {
+
+		inflater.push( compressed.subarray( i, i + INFLATE_STEP ), i + INFLATE_STEP >= compressed.length );
+
+	}
+
+	return out;
+
+}
