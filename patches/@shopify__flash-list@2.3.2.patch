diff --git a/dist/recyclerview/RecyclerViewManager.js b/dist/recyclerview/RecyclerViewManager.js
index 1aa651d9d985a36d3c6ef69f20407f51ca0e3e6f..bbe7120af173059892485cd43b4b09c5f333dcfb 100644
--- a/dist/recyclerview/RecyclerViewManager.js
+++ b/dist/recyclerview/RecyclerViewManager.js
@@ -293,7 +293,17 @@ export class RecyclerViewManager {
             // re-estimate unmeasured items with an updated average height, changing
             // the target item's position. Reading before recompute would capture a
             // stale offset, causing the wrong items to be rendered.
-            this.layoutManager.recomputeLayouts(0, initialScrollIndex);
+            // PATCH (filen-mobile): recompute the WHOLE layout table, not just [0..initialScrollIndex].
+            // Re-basing only the head with the post-measurement average leaves the tail chained off the
+            // 200px default estimate (LayoutManager's MultiTypeAverageWindow(5, 200)), so `layouts` stops
+            // being sorted by x at the seam. getVisibleLayouts binary-searches it and explicitly assumes
+            // sortedness, so it returns a wrong range (wrong cells mounted under a correct offset) or an
+            // EMPTY one (which flips isFirstLayoutComplete vacuously, since [].every() is true, and lets
+            // the initial scroll fire against a still-stale content width). The tail-resync in
+            // _recomputeLayouts cannot repair either: it is gated on `y`, which is always 0 on a
+            // horizontal list, so it never fires there. Upstream: Shopify/flash-list#2307 (open).
+            // Remove this patch once that is released.
+            this.layoutManager.recomputeLayouts(0, this.layoutManager.getLayoutCount() - 1);
             const initialItemLayout = this.layoutManager.getLayout(initialScrollIndex);
             const initialItemOffset = this.propsRef.horizontal
                 ? initialItemLayout.x
